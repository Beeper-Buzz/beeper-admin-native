{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@distribution": ["../../distributions/default/index.ts"]
    },
    "types": ["jest", "node"]
