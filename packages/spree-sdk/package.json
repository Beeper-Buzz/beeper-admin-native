{
  "name": "@instincts/spree-sdk",
  "version": "0.1.0",
  "description": "Version-adaptive Spree Commerce client for Spree 4.2 to 6.x: transport, errors, retries, store detection, sign-in and order adapters.",
  "keywords": [
    "spree",
    "spree-commerce",
    "ecommerce",
    "api-client",
    "sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1instinct/spree-admin-native.git",
    "directory": "packages/spree-sdk"
  },
  "homepage": "https://github.com/1instinct/spree-admin-native/tree/claude/admin-native-apps-planning-s43gki/packages/spree-sdk#readme",
  "bugs": "https://github.com/1instinct/spree-admin-native/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "contract": "vitest run --config vitest.contract.config.ts",
    "build": "tsup"
  },
  "dependencies": {
    "@instincts/spree-domain": "workspace:^",
    "@spree/admin-sdk": "^6.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@instincts/spree-config": "workspace:*",
    "@types/node": "^26.6.11",
    "tsup": "^9.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  }
}
