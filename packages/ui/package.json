{
  "name": "@instincts/spree-ui",
  "version": "0.1.0",
  "description": "Design tokens (\"The Counter\") and themes for Spree Admin Native and expo-spree, with WCAG contrast checks.",
  "keywords": [
    "spree",
    "design-tokens",
    "theme",
    "react-native"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1instinct/spree-admin-native.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/1instinct/spree-admin-native/tree/claude/admin-native-apps-planning-s43gki/packages/ui#readme",
  "bugs": "https://github.com/1instinct/spree-admin-native/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "build": "tsup"
  },
  "devDependencies": {
    "@instincts/spree-config": "workspace:*",
    "tsup": "^9.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./tokens": {
        "import": {
          "types": "./dist/tokens/index.d.ts",
          "default": "./dist/tokens/index.js"
        },
        "require": {
          "types": "./dist/tokens/index.d.cts",
          "default": "./dist/tokens/index.cjs"
        }
      }
    }
  }
}
